# ============================================
# GSUNET Backend Environment Variables
# ============================================
# Bu dosya şablondur. Gerçek değerlerinizi .env dosyasına yazın.
# .env dosyası Git'e gitmez (.gitignore'da)

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://gsu_user:gsu_password@localhost:5432/gsunet_db

# ============================================
# SECURITY
# ============================================
# ÖNEMLİ: Production'da mutlaka değiştirin!
# Güçlü random key üretmek için:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# OPENAI API (Review6: Sponsor Matching)
# ============================================
# Demo için ChatGPT API kullanılıyor
# Production'da on-prem AI modeli kullanılmalı
# API key almak için: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# APPLICATION
# ============================================
APP_NAME=GSUNET API
API_V1_STR=/api/v1
DEBUG=True

# ============================================
# CORS (virgülle ayrılmış)
# ============================================
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
